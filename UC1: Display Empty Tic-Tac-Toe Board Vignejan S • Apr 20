#include <iostream>
using namespace std;

int main() 
{
    // 3x3 Tic-Tac-Toe board
    char board[3][3];

    // Initialize the board with '-'
    for(int i = 0; i < 3; i++) 
    {
        for(int j = 0; j < 3; j++) 
        {
            board[i][j] = '-';
        }
    }

    // Print the board
    cout << "Tic-Tac-Toe Board:\n\n";

    for(int i = 0; i < 3; i++) 
    {
        for(int j = 0; j < 3; j++) 
        {
            cout << board[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
