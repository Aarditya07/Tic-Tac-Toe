import java.util.Scanner;

public class UC6_UpdateBoard {

    // Method to update the board
    public static void updateBoard(char[][] board, int row, int col, char symbol) {

        // Place symbol on the board
        board[row][col] = symbol;
    }

    // Method to print the board
    public static void printBoard(char[][] board) {

        for (int i = 0; i < 3; i++) {

            for (int j = 0; j < 3; j++) {

                System.out.print(board[i][j] + " ");
            }

            System.out.println();
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Create and initialize board
        char[][] board = {
                {'-', '-', '-'},
                {'-', '-', '-'},
                {'-', '-', '-'}
        };

        // Read row and column
        System.out.print("Enter row (0-2): ");
        int row = sc.nextInt();

        System.out.print("Enter column (0-2): ");
        int col = sc.nextInt();

        // Read symbol
        System.out.print("Enter symbol (X/O): ");
        char symbol = sc.next().charAt(0);

        // Update board
        updateBoard(board, row, col, symbol);

        // Display updated board
        System.out.println("\nUpdated Board:");

        printBoard(board);
    }
}
